{
  "name": "pi-session-modify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: /psm-edit rewrites one message in the current session, /psm-remove drops one turn, then reloads the session in place",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
