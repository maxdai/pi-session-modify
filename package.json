{
  "name": "@maxdai/pi-session-modify",
  "version": "0.1.0",
  "description": "Pi extension: edit one message or drop one turn of the current session in place, then reload it",
  "type": "module",
  "license": "MIT",
  "author": "maxdai",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxdai/pi-session-modify.git"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "extension",
    "session",
    "history"
  ],
  "pi": {
